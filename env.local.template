# Shell LLM Configuration
# Copy this file to .env.local and fill in your values

# Required: OpenRouter API key
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Default model (opus, sonnet, haiku, gpt4, or any OpenRouter model ID)
# Default: sonnet
# SHELL_LLM_DEFAULT_MODEL=sonnet

# Optional: Skip preprocessing (set to 1 to disable)
# SHELL_LLM_NO_PREPROCESS=0

# Optional: Direct mode - always skip preprocessing (set to 1)
# SHELL_LLM_DIRECT=0

# Optional: HTTP Referer for OpenRouter analytics
# OPENROUTER_REFERER=https://github.com/yourusername/shell-llm

# Optional: Enable debug output
# DEBUG=1
